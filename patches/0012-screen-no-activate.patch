+#if defined(_MSC_VER)
+                // USM patch 0012 (screen-no-activate) — see the configuration comment.
+                // Must complete BEFORE the first SwapBuffers (glClear + window_.display()
+                // below): the driver's promotion check runs at present time, so a window
+                // that sheds activation here is examined as an unfocused window and left
+                // on the composed path. The whole lambda is synchronous, so there is no
+                // race between this block and that first present.
+                if (config_.no_activate) {
+                    HWND hwnd = static_cast<HWND>(window_.getSystemHandle());
+                    // Never activatable by pointer input again. No wndproc subclass is
+                    // needed: SFML forwards unhandled messages to DefWindowProc, whose
+                    // WM_MOUSEACTIVATE handling honours WS_EX_NOACTIVATE — clicks reach
+                    // the window but never move foreground onto it. (The app-side
+                    // OutputGuard sweep sets the same bit ~200 ms later; too late for
+                    // the first present, which is why it lives here.)
+                    SetWindowLongPtrW(
+                        hwnd, GWL_EXSTYLE, GetWindowLongPtrW(hwnd, GWL_EXSTYLE) | WS_EX_NOACTIVATE);
+                    // Style bits are cached — SetWindowPos with SWP_FRAMECHANGED is the
+                    // documented way to flush them.
+                    SetWindowPos(hwnd,
+                                 nullptr,
+                                 0,
+                                 0,
+                                 0,
+                                 0,
+                                 SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_FRAMECHANGED);
+                    // Shed the activation window creation already took.
+                    if (GetForegroundWindow() == hwnd) {
+                        DWORD usm_prev_pid = 0;
+                        if (usm_prev_fg && IsWindow(usm_prev_fg)) {
+                            GetWindowThreadProcessId(usm_prev_fg, &usm_prev_pid);
+                        }
+                        if (usm_prev_pid != 0 && usm_prev_pid != GetCurrentProcessId()) {
+                            // This process holds foreground, so it is permitted to give
+                            // it away (SetForegroundWindow's rules).
+                            SetForegroundWindow(usm_prev_fg);
+                        }
+                        if (GetForegroundWindow() == hwnd) {
