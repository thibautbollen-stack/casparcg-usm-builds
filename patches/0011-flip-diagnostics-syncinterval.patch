+                case 0x80070057L: return L"E_INVALIDARG";
+                case 0x8007000EL: return L"E_OUTOFMEMORY";
+                case 0x80004001L: return L"E_NOTIMPL";
+                case 0x80004005L: return L"E_FAIL";
+                case 0x80070005L: return L"E_ACCESSDENIED";
