+    // USM patch 0011 (flip sync interval): DXGI Present() sync interval — how many
+    // vblanks each presented frame is held for.
+    //
+    // WHY. Present(1) holds one vblank, so flip only paces correctly when the display
+    // refresh EQUALS the channel fps; the app demotes any mismatch to the classic
+    // OpenGL path ("50 Hz but the channel is 25 fps"). But an INTEGER MULTIPLE is
+    // perfectly presentable: a 25 fps channel on a 50 Hz display is Present(2) — every
+    // second vblank — which is correctly paced AND genlocked. Without this, every
+    // mixed-rate rig is stuck on the classic path, and that is the path which blinks
+    // for ~0.2s on the first foreground change after playout starts.
+    //
+    // 1 (default) = unchanged behaviour. 2..4 = display refresh / channel fps.
+    // <flip-sync-interval> in config; USM_FLIP_SYNC env var overrides for drop-in
+    // A/B testing without an app release.
+    int             flip_sync_interval = 1;
 };
 
