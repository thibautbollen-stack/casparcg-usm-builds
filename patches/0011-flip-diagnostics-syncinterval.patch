+        // dependency, and a name is more use in a field log than raw hex.
+        const auto hr_name = [](HRESULT hr) -> const wchar_t* {
+            switch (hr) {
+                case 0x887A0001L: return L"DXGI_ERROR_INVALID_CALL";
+                case 0x887A0004L: return L"DXGI_ERROR_UNSUPPORTED";
+                case 0x887A0005L: return L"DXGI_ERROR_DEVICE_REMOVED";
+                case 0x887A0006L: return L"DXGI_ERROR_DEVICE_HUNG";
+                case 0x887A0007L: return L"DXGI_ERROR_DEVICE_RESET";
+                case 0x887A0020L: return L"DXGI_ERROR_NOT_CURRENTLY_AVAILABLE";
