@@ -0,0 +1,34 @@
+/*
+ * USM patch 0006 — foldscroll:// producer.
+ *
+ * Renders the perimeter-scroll FOLD of a source channel entirely server-side:
+ * one producer, one route subscription, N transform-only sub-frames of the SAME
+ * source texture (the mixer flattens the tree), with the scroll offset advanced
+ * internally every rendered frame. Replaces the app's 24-route-slice + per-frame
+ * MIXER engine — no route-layer GPU blow-up, no tweens, no AMCP motion traffic.
+ *
+ * The fold geometry is a C++ port of scroll-slices.js (loopGeometry +
+ * computeScrollSlices); the per-slice transforms mirror sliceMixerParams.
+ *
+ * URI:   foldscroll://<channel>[-<layer>]
+ * Params: PW <panelWidth> PH <panelHeight> N <totalPanels> P <panelsPerRow>
+ *         SPEED <pxPerSecond> DIR <1|-1> [OFFSET <px>]
+ * Live retune via CALL: SPEED <pxPerSecond> | DIR <1|-1> | OFFSET <px>.
+ * Every CALL replies with the live offset (px), so `CALL <ch>-<layer> STATUS`
+ * reads it — used for seamless engine handover. The offset advances by
+ * measured wall-clock time (speed stays exact on free-running channels).
+ */
+
+#pragma once
+
+#include <core/producer/frame_producer.h>
+
+#include <string>
+#include <vector>
+
+namespace caspar { namespace core {
+
+spl::shared_ptr<core::frame_producer> create_foldscroll_producer(const core::frame_producer_dependencies& dependencies,
+                                                                 const std::vector<std::wstring>&         params);
+
+}} // namespace caspar::core
